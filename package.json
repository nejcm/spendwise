{
  "name": "spendwise",
  "version": "1.4.9",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user/repo-name.git"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "prebuild": "pnpm expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "xcode": "xed -b ios",
    "doctor": "npx expo-doctor@latest",
    "assets:jpg": "tsx scripts/svg-to-jpg.ts",
    "preinstall": "npx only-allow pnpm",
    "start:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run start",
    "prebuild:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "prebuild:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run android",
    "ios:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run ios",
    "start:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run start",
    "prebuild:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run android",
    "ios:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run ios",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:development:android": "eas build --profile development --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "prepare": "husky",
    "app-release": "cross-env SKIP_BRANCH_PROTECTION=true np --no-publish --no-cleanup --no-release-draft --message \"chore(release): v%s [skip ci]\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ts": "tsc --noEmit",
    "lint:all": "pnpm run lint && pnpm run lint:ts && pnpm run lint:translations",
    "format": "eslint . --fix",
    "lint:translations": "eslint ./src/translations/ --fix --ext .json",
    "test": "jest --runInBand",
    "verify": "pnpm run lint && pnpm run lint:ts && pnpm run lint:translations && pnpm run test",
    "test:ci": "pnpm run test --coverage",
    "test:watch": "pnpm run test --watch",
    "install-maestro": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
    "e2e-test": "maestro test .maestro/ -e APP_ID=com.obytes.development",
    "knip:check": "pnpm exec knip"
  },
  "dependencies": {
    "@date-fns/utc": "2.1.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/dom-webview": "57.0.1",
    "@expo/metro-runtime": "57.0.14",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.23.0",
    "@tanstack/react-query": "5.102.8",
    "app-icon-badge": "0.1.2",
    "date-fns": "4.4.0",
    "es-toolkit": "1.52.0",
    "expo": "57.0.17",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "57.0.15",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.16",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.6",
    "expo-font": "57.0.1",
    "expo-haptics": "57.0.2",
    "expo-image": "57.0.3",
    "expo-image-manipulator": "57.0.14",
    "expo-image-picker": "57.0.14",
    "expo-linear-gradient": "57.0.1",
    "expo-linking": "57.0.8",
    "expo-local-authentication": "57.0.2",
    "expo-localization": "57.0.1",
    "expo-notifications": "57.0.15",
    "expo-router": "57.0.17",
    "expo-sharing": "57.0.16",
    "expo-splash-screen": "57.0.8",
    "expo-sqlite": "57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "expo-updates": "57.0.18",
    "fuse.js": "7.5.0",
    "i18next": "26.4.0",
    "lucide-react-native": "1.35.0",
    "moti": "0.30.0",
    "posthog-react-native": "4.66.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "6.1.3",
    "react-i18next": "17.0.12",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "1.8.1",
    "react-native-enriched-markdown": "0.7.4",
    "react-native-flash-message": "0.4.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-gifted-charts": "1.4.78",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-restart": "0.0.29",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-sortables": "1.10.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "react-query-kit": "3.3.4",
    "simple-icons": "16.28.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "uniwind": "1.11.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@babel/core": "7.29.7",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@dev-plugins/react-query": "0.4.0",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@expo/config": "57.0.9",
    "@react-native-community/cli": "20.2.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react-native": "13.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/invariant": "2.2.37",
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-preset-expo": "57.0.9",
    "better-sqlite3": "12.10.0",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-i18n-json": "4.0.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "jest-junit": "17.0.0",
    "knip": "6.32.3",
    "lint-staged": "17.4.1",
    "np": "12.0.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-restart"
        ]
      }
    },
    "install": {
      "exclude": [
        "eslint-config-expo",
        "expo",
        "expo-constants",
        "expo-font",
        "expo-updates"
      ]
    }
  },
  "osMetadata": {
    "initVersion": "9.0.0"
  }
}
