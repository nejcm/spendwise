+++ b/android/src/main/java/expo/modules/shareintent/ExpoShareIntentSingleton.kt
@@ -12,4 +12,15 @@ object ExpoShareIntentSingleton : SingletonModule {
   // members to store the initial launch intent
   var intent: Intent? = null
   var isPending: Boolean = false
+
+  // Synchronized: the activity stores on the main thread while getShareIntent takes on the module queue.
+  @Synchronized fun store(next: Intent) {
+    intent = next
+    isPending = true
+  }
+
+  @Synchronized fun take(): Intent? = intent.also {
+    intent = null
+    isPending = false
+  }
 }
